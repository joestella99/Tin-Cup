<section class="hero"><p class="eyebrow">THE TRIP IS THE TOURNAMENT</p><h1>A few rounds.<br>A year's worth of<br><em>bragging rights.</em></h1><p class="lede">One home for your annual golf trip. Get the buddies together. Put something on the line.</p><%= link_to "Plan a trip ↗", new_trip_path, class: "button" %><div class="hero-stamp">18<br><small>HOLES AT A TIME</small></div></section>
<div class="section-heading"><h2>The trip calendar</h2><span><%= pluralize(@trips.count, "trip") %> on the books</span></div>
<div class="trip-grid"><% @trips.each do |trip| %><%= link_to trip, class: "trip-card" do %><p class="eyebrow"><%= trip.starts_on.strftime("%b %Y") %> / <%= trip.destination %></p><h3><%= trip.name %></h3><p><%= trip.starts_on.strftime("%b %-d") %> – <%= trip.ends_on.strftime("%b %-d, %Y") %></p><div class="card-bottom"><span><%= pluralize(trip.players.count, "player") %> · <%= pluralize(trip.rounds.count, "round") %></span><b>Open trip ↗</b></div><% end %><% end %></div>
<% if @trips.empty? %><section class="empty"><h3>The first annual starts here.</h3><p>Create a trip and give your group something to play for.</p></section><% end %>
