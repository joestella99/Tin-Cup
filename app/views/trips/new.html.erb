<%= link_to "← All trips", trips_path, class: "back" %><section class="hero compact"><p class="eyebrow">MAKE IT AN ANNUAL THING</p><h1>Put it on<br>the calendar.</h1></section><section class="panel narrow"><h2>New golf trip</h2><% if @trip.errors.any? %><p role="alert"><%= @trip.errors.full_messages.to_sentence %></p><% end %><%= form_with model: @trip do |f| %><%= f.label :name, "Trip name" %><%= f.text_field :name, required: true, placeholder: "The Boys' Annual Cup" %><%= f.label :destination %><%= f.text_field :destination, required: true, placeholder: "Pinehurst, NC" %><div class="form-grid"><div><%= f.label :starts_on %><%= f.date_field :starts_on, required: true %></div><div><%= f.label :ends_on %><%= f.date_field :ends_on, required: true %></div></div><%= f.submit "Create the trip", class: "button" %><% end %></section>
