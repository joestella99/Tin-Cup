<%= link_to "← Your trips", trips_path, class: "back" %>
<header class="hq-hero">
  <div class="hq-hero-copy">
    <p class="eyebrow">TIN CUP / <%= @trip.destination %></p>
    <h1><%= @trip.name %></h1>
    <p><%= @trip.starts_on.strftime("%B %-d") %> – <%= @trip.ends_on.strftime("%B %-d, %Y") %> <span class="hq-hero-dot">·</span> <%= pluralize(@trip.players.count, "golfer") %> <span class="hq-hero-dot">·</span> <%= pluralize(@rounds.size, "round") %></p>
  </div>
  <div class="hq-hero-actions">
    <%= link_to "⚑ Live clubhouse", trip_clubhouse_path(@trip), class: "button button-gold" %>
    <% if @spectator_pass %><%= link_to "Watch party ↗", watch_path(@spectator_pass.share_token), class: "hq-secondary-link" %><% end %>
    <% if @can_manage %><%= link_to "Invite friends", trip_path(@trip, view: "manage", anchor: "trip-access"), class: "hq-secondary-link" %><% end %>
  </div>
</header>

<nav class="hq-tabs" aria-label="Trip navigation">
  <% { "overview" => "Home", "play" => "Play & score", "standings" => "Leaderboards" }.merge(@can_manage ? { "manage" => "Captain's desk" } : {}).each do |view, title| %>
    <%= link_to title, trip_path(@trip, view: view), class: "hq-tab #{'active' if @view == view}", aria: { current: @view == view ? "page" : nil } %>
  <% end %>
</nav>

<% if @view == "overview" %>
  <div class="hq-feature-grid">
    <section class="hq-next-card">
      <p class="eyebrow"><%= @focus_round ? "UP NEXT / YOUR FIRST TEE" : "FIRST THINGS FIRST" %></p>
      <% if @focus_round %>
        <h2><%= @focus_round.course %></h2>
        <p class="hq-date"><%= @focus_round.plays_on.strftime("%A, %B %-d") %></p>
        <span class="hq-state"><%= @pulse.round_state(@focus_round) %></span>
        <div class="hq-meter" role="progressbar" aria-label="Round scoring progress" aria-valuenow="<%= @pulse.progress(@focus_round) %>" aria-valuemin="0" aria-valuemax="100"><span style="width: <%= @pulse.progress(@focus_round) %>%"></span></div>
        <p class="hq-note"><%= @pulse.progress(@focus_round) %>% of the field's scores recorded</p>
        <%= link_to(@focus_round.course_confirmed? || @focus_round.total? ? "Go to scorecard →" : "Prepare this course →", @focus_round.course_confirmed? || @focus_round.total? ? trip_round_path(@trip, @focus_round) : edit_trip_round_course_card_path(@trip, @focus_round), class: "button hq-primary-action") %>
      <% else %>
        <h2>The weekend starts here.</h2>
        <p>Add the first course to put your trip on the map. Your next round will appear right here.</p>
        <% if @can_manage %><%= link_to "Schedule your first round →", trip_path(@trip, view: "manage", anchor: "schedule-round"), class: "button hq-primary-action" %><% else %><p class="hq-note">Your captain is setting the itinerary.</p><% end %>
      <% end %>
    </section>
    <section class="hq-story-card">
      <p class="eyebrow"><%= @pulse.story.kicker %></p>
      <h2><%= @pulse.story.headline %></h2>
      <p><%= @pulse.story.detail %></p>
      <%= link_to "See the live drama →", trip_clubhouse_path(@trip), class: "hq-story-link" %>
    </section>
  </div>

  <% if @can_manage && !@pulse.ready? %>
    <section class="hq-checklist-preview">
      <div><p class="eyebrow">CAPTAIN'S BRIEFING</p><h2><%= @pulse.completed_steps %> of <%= @pulse.steps.size %> essentials ready</h2><p>Everything you need to get this trip tournament-ready. No hunting through settings.</p></div>
      <%= link_to "Finish setup →", trip_path(@trip, view: "manage"), class: "button" %>
    </section>
  <% end %>

  <% if @teams.any? %><%= render "cup", trip: @trip, entries: @cup_entries, teams: @teams %><% end %>

  <div class="hq-two-column">
    <%= render "itinerary" %>
    <%= render "standings" %>
  </div>
  <% if @rounds.any? %>
    <div class="hq-bottom-cta"><span>Scores change the story in real time.</span><%= link_to "Open the clubhouse →", trip_clubhouse_path(@trip), class: "small-button" %></div>
  <% end %>

<% elsif @view == "play" %>
  <div class="hq-page-title"><div><p class="eyebrow">THE WEEKEND PLAYBOOK</p><h2>Every tee time. One place to score.</h2><p>Choose the course you're playing. All golfers can enter scores, and the leaderboard updates as the cards come in.</p></div><% if @can_manage %><%= link_to "+ Schedule a round", trip_path(@trip, view: "manage", anchor: "schedule-round"), class: "small-button" %><% end %></div>
  <div class="hq-round-grid">
    <% @rounds.each_with_index do |round, index| %>
      <article class="hq-round-card">
        <div class="hq-round-head"><span>ROUND <%= "%02d" % (index + 1) %></span><span class="hq-round-status"><%= @pulse.round_state(round) %></span></div>
        <p class="hq-round-date"><time datetime="<%= round.plays_on.iso8601 %>"><%= round.plays_on.strftime("%A · %B %-d") %></time></p>
        <h3><%= round.course %></h3>
        <p class="hq-note"><%= round.hole_by_hole? ? "Hole-by-hole scoring + match play" : "18-hole total scoring" %></p>
        <div class="hq-meter" role="progressbar" aria-label="<%= round.course %> scoring progress" aria-valuenow="<%= @pulse.progress(round) %>" aria-valuemin="0" aria-valuemax="100"><span style="width: <%= @pulse.progress(round) %>%"></span></div>
        <p class="hq-note"><%= @pulse.progress(round) %>% scored</p>
        <div class="hq-round-actions">
          <%= link_to "Open scorecard →", trip_round_path(@trip, round), class: "button" %>
          <% if round.hole_by_hole? %><%= link_to "Skins", trip_round_skins_game_path(@trip, round), class: "small-button" %><% end %>
        </div>
      </article>
    <% end %>
  </div>
  <% if @rounds.empty? %><section class="panel hq-empty"><h2>No rounds on the card yet.</h2><p>Your captain can add a course and a date to get the weekend rolling.</p><% if @can_manage %><%= link_to "Schedule a round →", trip_path(@trip, view: "manage", anchor: "schedule-round"), class: "button" %><% end %></section><% end %>

<% elsif @view == "standings" %>
  <div class="hq-page-title"><div><p class="eyebrow">BRAGGING RIGHTS CENTRAL</p><h2>Every point matters.</h2><p>Individual net standings, singles Cup points, and the games within the game.</p></div><%= link_to "Live clubhouse →", trip_clubhouse_path(@trip), class: "small-button" %></div>
  <%= render "cup", trip: @trip, entries: @cup_entries, teams: @teams %>
  <%= render "standings" %>
  <% if @rounds.any?(&:hole_by_hole?) %>
    <section class="panel"><p class="eyebrow">THE SIDE QUESTS</p><h2>Skins and side games</h2><div class="hq-link-grid"><% @rounds.select(&:hole_by_hole?).each do |round| %><%= link_to "♠ #{round.course} · Skins →", trip_round_skins_game_path(@trip, round), class: "small-button" %><% end %></div></section>
  <% end %>

<% elsif @view == "manage" && @can_manage %>
  <div class="hq-page-title"><div><p class="eyebrow">CAPTAIN'S DESK</p><h2>Run the trip. Not a spreadsheet.</h2><p>Four quick jobs get the competition rolling. Every setup tool lives here, away from the live action.</p></div><%= link_to "Edit trip details", edit_trip_path(@trip), class: "small-button" %></div>
  <section class="panel hq-preflight">
    <div class="hq-section-head"><div><p class="eyebrow">THE PRE-FLIGHT CHECKLIST</p><h2><%= @pulse.completed_steps %> / <%= @pulse.steps.size %> ready</h2></div><span class="hq-preflight-count"><%= (@pulse.completed_steps.fdiv(@pulse.steps.size) * 100).round %>%</span></div>
    <div class="hq-meter"><span style="width: <%= (@pulse.completed_steps.fdiv(@pulse.steps.size) * 100).round %>%"></span></div>
    <div class="hq-task-grid">
      <% @pulse.steps.each_with_index do |step, index| %>
        <%= link_to step.path, class: "hq-task #{'complete' if step.done}" do %>
          <span class="hq-task-icon"><%= step.done ? "✓" : "%02d" % (index + 1) %></span>
          <span><strong><%= step.title %></strong><small><%= step.done ? "Ready to go" : step.detail %></small></span>
          <span class="hq-task-arrow">→</span>
        <% end %>
      <% end %>
    </div>
  </section>

  <div class="setup-grid hq-setup-grid">
    <section class="panel" id="add-player">
      <p class="eyebrow">01 / THE FIELD</p><h2>Add a golfer</h2>
      <%= form_with model: [@trip, Player.new] do |f| %>
        <%= f.label :name, "Golfer's name" %><%= f.text_field :name, required: true, placeholder: "Your buddy's name" %>
        <%= f.label :team_id, "Team" %><%= f.collection_select :team_id, @teams, :id, :name, include_blank: "Assign later" %>
        <%= f.label :playing_handicap, "Agreed playing handicap" %><%= f.number_field :playing_handicap, value: 0, min: -10, max: 54, required: true %>
        <p class="muted">Enter strokes received for 18 holes, not the handicap index.</p>
        <%= f.submit "Add golfer →", class: "button" %>
      <% end %>
    </section>

    <section class="panel" id="schedule-round">
      <p class="eyebrow">02 / THE BATTLEGROUNDS</p><h2>Schedule a round</h2>
      <div class="course-library-invite"><p>Search real courses and bring their hole data into your tournament where available.</p><%= link_to "Explore course database →", trip_golf_courses_path(@trip), class: "small-button" %></div>
      <% tee_map = @golf_courses.to_h { |course| [ course.id.to_s, course.tee_names ] } %>
      <%= form_with model: [@trip, Round.new], data: { controller: "course-tee-picker", course_tee_picker_map_value: tee_map.to_json, course_tee_picker_selected_value: @selected_tee.to_s } do |f| %>
        <%= f.label :golf_course_id, "Course from your library" %>
        <%= f.collection_select :golf_course_id, @golf_courses, :id, :display_name, { include_blank: "Or enter a course manually", selected: @selected_course_id }, data: { action: "change->course-tee-picker#update", course_tee_picker_target: "course" } %>
        <%= f.label :tee_name, "Tee box (when available)" %>
        <%= f.select :tee_name, [], { include_blank: "Choose a course first" }, data: { course_tee_picker_target: "tee" } %>
        <%= f.label :course, "Manual course name (optional if selected)" %><%= f.text_field :course, placeholder: "e.g. Pinehurst No. 2" %>
        <%= f.label :plays_on, "Date on the trip" %><%= f.date_field :plays_on, min: @trip.starts_on, max: @trip.ends_on, required: true %>
        <%= f.label :scoring_mode, "Scoring style" %><%= f.select :scoring_mode, [["Hole by hole + singles matches", "hole_by_hole"], ["18-hole totals only", "total"]] %>
        <p class="muted">For live matches, confirm the course's 18-hole card before scoring.</p>
        <%= f.submit "Add to itinerary →", class: "button" %>
      <% end %>
    </section>
  </div>
  <section id="manage-teams"><%= render "cup", trip: @trip, entries: @cup_entries, teams: @teams %></section>
  <%= render "roster", trip: @trip, teams: @teams %>
  <%= render "access", trip: @trip, invitation: @active_invitation %>
  <%= render "spectator_access", trip: @trip, pass: @spectator_pass %>
<% end %>
