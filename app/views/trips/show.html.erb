<%= link_to "← All trips", trips_path, class: "back" %>
<section class="hero compact"><p class="eyebrow"><%= @trip.destination %> / <%= @trip.starts_on.strftime("%b %-d") %> – <%= @trip.ends_on.strftime("%b %-d, %Y") %></p><h1><%= @trip.name %></h1><p class="lede">The courses change. The rivalry travels.</p></section>
<div class="stats"><div><b><%= @trip.players.count %></b><span>Players in the mix</span></div><div><b><%= @rounds.size %></b><span>Rounds on the books</span></div><div><b>NET</b><span>Individual stroke play</span></div></div>
<section class="clubhouse-invite"><div><p class="eyebrow">THE LIVE CLUBHOUSE</p><h2>More than a scorecard. This is the show.</h2><p>Live leaderboards, match updates, and a highlight reel for every birdie, eagle and ace. The whole trip, one screen.</p></div><%= link_to "Enter the clubhouse ↗", trip_clubhouse_path(@trip), class: "button" %></section>
<% if @can_manage %><p class="trip-actions"><%= link_to "Edit trip details", edit_trip_path(@trip), class: "small-button" %><%= link_to(@trip.ownership ? "Invite the group ↗" : "Claim and share this trip ↗", "#trip-access", class: "small-button") %></p><% end %>
<%= render "cup", trip: @trip, entries: @cup_entries, teams: @teams %>
<section class="tournament-upgrade"><p class="eyebrow">NEW · THE TOURNAMENT DIRECTOR</p><h2>Every round. More ways to win.</h2><p>Run a skins competition alongside your Cup, generate fair singles pairings, and keep every shot in the live clubhouse.</p><div><% @rounds.select(&:hole_by_hole?).each do |round| %><%= link_to "♠ #{round.course} skins ↗", trip_round_skins_game_path(@trip, round), class: "small-button" %><% end %></div></section>
<div class="workspace"><section class="panel"><p class="eyebrow">THE CUP CHASE</p><h2>Trip standings</h2><p class="muted">Lowest cumulative net wins. Only players with every scheduled round scored are eligible for the lead. Equal totals are tied.</p><div class="table-scroll"><table><thead><tr><th>Place</th><th>Player</th><th>Rounds</th><th>Gross</th><th>Net</th></tr></thead><tbody><% last_net = nil; place = nil; @entries.each_with_index do |entry, index| %><% if entry.complete && entry.net != last_net; place = index + 1; last_net = entry.net; end %><tr><td><%= entry.complete ? place : "—" %></td><td><strong><%= entry.player.name %></strong><small>Playing handicap <%= entry.player.playing_handicap %></small></td><td><%= entry.rounds_played %>/<%= @rounds.size %></td><td><%= entry.rounds_played.positive? ? entry.gross : "—" %></td><td class="net"><%= entry.rounds_played.positive? ? entry.net : "—" %><% unless entry.complete %><small>Pending</small><% end %></td></tr><% end %></tbody></table></div><% if @entries.empty? %><p class="empty">Add your first player to get the competition started.</p><% end %></section>
<aside><%= render "itinerary" %></aside></div>
<% if @can_manage %>
<div class="setup-grid"><section class="panel"><h2>Add a buddy</h2><%= form_with model: [@trip, Player.new] do |f| %><%= f.label :name, "Player name" %><%= f.text_field :name, required: true %><%= f.label :team_id, "Team (optional)" %><%= f.collection_select :team_id, @teams, :id, :name, include_blank: "Unassigned" %><%= f.label :playing_handicap, "Agreed playing handicap (18 holes)" %><%= f.number_field :playing_handicap, value: 0, min: -10, max: 54, required: true %><p class="muted">Enter strokes received, not a handicap index. Use a negative number for a plus handicap. This version uses the same agreed allowance for every round.</p><%= f.submit "Add player", class: "button" %><% end %></section><section class="panel"><h2 id="schedule-round">Schedule a round</h2><%= form_with model: [@trip, Round.new] do |f| %><%= f.label :course, "Course name" %><%= f.text_field :course, required: true %><%= f.label :plays_on, "Round date" %><%= f.date_field :plays_on, min: @trip.starts_on, max: @trip.ends_on, required: true %><%= f.label :scoring_mode, "Score entry" %><%= f.select :scoring_mode, [["Hole by hole + singles matches", "hole_by_hole"], ["18-hole totals only", "total"]] %><p class="muted">Hole-by-hole rounds support live singles matches alongside individual net standings. Confirm the course card after adding the round.</p><%= f.submit "Add round", class: "button" %><% end %></section></div>

<% end %>
<%= render "roster", trip: @trip, teams: @teams %>
<% if @can_manage %><%= render "access", trip: @trip, invitation: @active_invitation %><% else %><p class="muted">You joined as a scorer. Open a round to enter scores for the group.</p><% end %>
