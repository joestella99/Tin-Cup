<%= link_to "← Back to the trip", trip_path(@trip), class: "back" %><section class="hero compact score-hero"><p class="eyebrow"><%= @trip.name %> / <%= @round.plays_on.strftime("%A, %b %-d") %></p><h1><%= @round.course %></h1><p class="lede">Finish the round. Make it official.</p></section>
<% if @round.golf_course %><p class="course-source-note"><%= "#{@round.tee_name} tees · " if @round.tee_name.present? %>Course library · <%= @round.golf_course.location %> · <%= link_to "View course information ↗", trip_golf_course_path(@trip, @round.golf_course) %></p><% end %>
<p class="trip-actions"><%= link_to "↗ Live clubhouse", trip_clubhouse_path(@trip, round_id: @round.id), class: "small-button" %></p>
<% if @can_manage %>
  <p><%= link_to "Edit round schedule", edit_trip_round_path(@trip, @round), class: "small-button" %></p>
<% end %>
<% if @round.hole_by_hole? %>
  <% if @round.course_confirmed? %>
    <section class="cart-entry-banner">
      <div><p class="eyebrow">THE FIVE-SECOND SCORECARD</p><h2>Score it. Pocket it. Play on.</h2><p>Big one-tap scoring built for the golf cart. No typing, no digging through menus.</p></div>
      <%= link_to "Open Cart Mode →", cart_trip_round_path(@trip, @round), class: "cart-banner-button" %>
    </section>
  <% end %>
  <div class="round-extras"><%= link_to "♠ Skins competition ↗", trip_round_skins_game_path(@trip, @round), class: "small-button" %><% if @can_manage && @round.course_confirmed? %><%= link_to "⚑ Auto-build pairings ↗", trip_round_pairing_suggestions_path(@trip, @round), class: "small-button" %><% end %></div>
  <% if @round.course_confirmed? %>
    <section class="score-import-banner">
      <div><p class="eyebrow">ALREADY SCORED IN ANOTHER APP?</p><h2>Bring in your entire scorecard.</h2><p>Import 18 holes at once instead of entering each score again.</p></div>
      <%= link_to "Import a scorecard →", new_trip_round_scorecard_import_path(@trip, @round), class: "button button-gold" %>
    </section>
  <% end %>
  <%= render "hole_card" %>
  <%= render "matches" %>
<% else %>
<section class="panel"><h2>The scorecard</h2><p class="muted">Enter each player's total gross strokes for all 18 holes. Net = gross − agreed playing handicap. Blank fields clear previously saved scores. All scores save together.</p><% if @players.empty? %><p>Add players from the trip page before recording scores.</p><% else %><%= form_with url: trip_round_scorecard_path(@trip, @round), method: :patch do %><div class="table-scroll"><table><thead><tr><th>Player</th><th>Playing handicap</th><th>Gross strokes</th><th>Saved net</th></tr></thead><tbody><% @players.each do |player| %><% score = @scores[player.id] %><tr><td><%= label_tag "score_#{player.id}", player.name %></td><td><%= player.playing_handicap %></td><td><%= number_field_tag "scores[#{player.id}]", score&.gross, id: "score_#{player.id}", min: 1, max: 300, step: 1, class: "score-input" %></td><td class="net"><%= score&.net || "—" %></td></tr><% end %></tbody></table></div><%= submit_tag "Save round scores ↗", class: "button" %><% end %><% end %></section>

<% end %>
