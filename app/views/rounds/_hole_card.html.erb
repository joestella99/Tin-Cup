<% unless @round.course_confirmed? %>
<section class="panel course-notice">
<p class="eyebrow">BEFORE THE FIRST TEE</p>
<h2>Confirm your course card</h2>
<p>Set each hole's par and stroke index from the actual course scorecard. These control where handicap strokes fall in matches.</p>
<% if @can_manage %><%= link_to "Set up the 18 holes ↗", edit_trip_round_course_card_path(@trip, @round), class: "button" %><% else %><p class="muted">Your organizer needs to confirm this course before scoring begins.</p><% end %>
</section>
<% else %>
<section class="panel">
<div class="section-heading cup-heading">
<div>
<p class="eyebrow">ONE HOLE AT A TIME</p>
<h2>The scorecard</h2>
</div>
<%= link_to "View course card", edit_trip_round_course_card_path(@trip, @round), class: "back" %>
</div>
<div class="score-focus">
  <div><p class="eyebrow">ON-COURSE MODE</p><h3>Who are you scoring for?</h3><p class="muted">Focus on one golfer to keep your screen clear, or score everyone together.</p></div>
  <div class="score-focus-players" aria-label="Choose a golfer">
    <%= link_to "Everyone", trip_round_path(@trip, @round, hole: @hole&.number || 1, player_id: "all"), class: "score-focus-chip #{'selected' unless @scoring_player}" %>
    <% @players.each do |player| %>
      <%= link_to player.name, trip_round_path(@trip, @round, hole: @hole&.number || 1, player_id: player.id), class: "score-focus-chip #{'selected' if @scoring_player == player}" %>
    <% end %>
  </div>
</div>
<div class="score-round-progress"><strong><%= @scored_hole_ids.size %> of 18 holes</strong><span><%= @scoring_player ? "Scored for #{@scoring_player.name}" : "With at least one entry" %></span></div>
<nav class="hole-nav" aria-label="Choose hole">
<% @round.holes.order(:number).each do |hole| %>
<%= link_to hole.number, trip_round_path(@trip, @round, hole: hole.number, player_id: @scoring_player&.id || ("all" if params[:player_id] == "all")), class: "hole-chip #{'selected' if hole == @hole} #{'hole-scored' if @scored_hole_ids.include?(hole.id)}", aria: {current: hole == @hole ? "page" : nil, label: "Hole #{hole.number}#{@scored_hole_ids.include?(hole.id) ? ', has scores' : '' }"} %>
<% end %>
</nav>
<% if @hole %>
<div class="hole-heading">
<h3>Hole <%= @hole.number %>
</h3>
<span>Par <%= @hole.par %> · Stroke index <%= @hole.stroke_index %>
</span>
</div>
<p class="muted">Enter gross strokes. Blank clears a saved score. Partial rounds stay pending in the individual trip standings. Match results use consecutive completed holes from the first tee.</p>
<%= form_with url: trip_round_hole_hole_scores_path(@trip, @round, @hole), method: :patch do %>
<%= hidden_field_tag :player_id, @scoring_player&.id || ("all" if params[:player_id] == "all") %>
<div class="scoring-grid <%= 'focus-single' if @scoring_player %>">
  <% @scoring_players.each do |player| %>
    <% result = @results[player.id] %>
    <article class="scoring-card">
      <div class="scoring-card-heading">
        <div><strong><%= player.name %></strong><small><%= player.team&.name || "Unassigned" %> · HCP <%= player.playing_handicap %></small></div>
        <div class="scoring-card-meta"><strong><%= result&.holes_played || 0 %>/18</strong><small>HOLES SCORED</small></div>
      </div>
      <div class="score-stepper" data-controller="score-stepper" data-score-stepper-par-value="<%= @hole.par %>">
        <button type="button" class="score-step-button" data-action="score-stepper#decrement" aria-label="Subtract a stroke for <%= player.name %>">−</button>
        <%= number_field_tag "strokes[#{player.id}]", @hole_scores[player.id]&.strokes, id: "hole_score_#{player.id}", min: 1, max: 30, step: 1, inputmode: "numeric", class: "score-input", aria: { label: "Strokes for #{player.name} on hole #{@hole.number}" }, data: { score_stepper_target: "input" } %>
        <button type="button" class="score-step-button" data-action="score-stepper#increment" aria-label="Add a stroke for <%= player.name %>">+</button>
        <button type="button" class="score-par-button" data-action="score-stepper#setPar" aria-label="Set <%= player.name %> to par <%= @hole.par %>">PAR <%= @hole.par %></button>
      </div>
      <p class="scoring-card-totals">Round total <strong><%= result&.gross || "—" %> gross</strong><span> · </span><strong><%= result&.net || "—" %> net</strong></p>
    </article>
  <% end %>
</div>
<div class="score-save-actions">
  <%= submit_tag "Save hole #{@hole.number}", class: "button" %>
  <% if @hole.number < 18 %>
    <%= button_tag "Save & next hole →", type: "submit", name: "next_hole", value: "1", class: "button button-gold" %>
  <% end %>
</div>
<% end %>
<div class="hole-pagination">
<% if @hole.number > 1 %>
<%= link_to "← Previous hole", trip_round_path(@trip, @round, hole: @hole.number - 1, player_id: @scoring_player&.id || ("all" if params[:player_id] == "all")) %>
<% end %>
<% if @hole.number < 18 %>
<%= link_to "Next hole →", trip_round_path(@trip, @round, hole: @hole.number + 1, player_id: @scoring_player&.id || ("all" if params[:player_id] == "all")) %>
<% end %>
</div>
<% else %>
<p>Choose a hole above.</p>
<% end %>
</section>
<% end %>
